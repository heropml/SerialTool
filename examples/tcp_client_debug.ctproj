          "ser_databits": "8",
          "ser_parity": "None",
          "ser_stopbits": "1",
          "ser_flow": "None",
          "serial_dtr": true,
          "serial_rts": true,
          "net_local_ip": "0.0.0.0",
          "net_local_port": "8080",
          "net_remote_ip": "127.0.0.1",
          "net_remote_port": "9000",
          "net_use_remote": false,
          "net_group_addr": "239.0.0.1",
          "vconn_loopback": false,
          "auto_reconnect": true
