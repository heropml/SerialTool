{
  "format": "commtool-project",
  "format_version": 2,
  "app_version": "1.8.0",
  "name": "Fixed Header Demo",
  "metadata": {
    "device_type": "generic",
    "protocol_template": "fixed_header",
    "connection_type": "Virtual",
    "description": "AA 55 fixed-header HEX frames on Virtual loopback with plot HEX fields."
