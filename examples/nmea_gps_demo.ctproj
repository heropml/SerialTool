{
  "format": "commtool-project",
  "format_version": 2,
  "app_version": "1.5.4",
  "name": "NMEA GPS Demo",
  "metadata": {
    "device_type": "sensor",
    "protocol_template": "nmea",
    "connection_type": "Serial",
    "description": "NMEA line mode @ 9600 with sample $GPGGA / $GPGSA snippets."
  },
  "settings": {
    "hexdump_view": false,
    "numview": false,
    "ansi_color": false,
    "proto_highlight": false,
    "packet_split": false,
    "packet_timeout": "20",
    "line_split": true,
    "line_nl_mode": 0,
    "tx_hex": false,
    "append_newline": false,
    "append_nl_mode": 0,
    "checksum_idx": 0,
    "encoding": "ascii",
    "frame_rules": "",
    "plot_mode": 0,
    "plot_sep": 0,
    "plot_regex": "",
    "plot_hex_fields": "",
    "plot_hex_header": "",
    "dash_mode": 0,
    "dash_sep": 0,
    "dash_regex": "",
    "dash_fields": "",
    "dash_header": "",
    "net_proto": "Serial",
    "rx_hex": false,
    "ser_baud": "9600",
    "show_timestamp": true,
    "snippets": "[{\"name\": \"GPGGA sample\", \"text\": \"$GPGGA,123519,4807.038,N,01131.000,E,1,08,0.9,545.4,M,46.9,M,,*47\", \"hex\": false}, {\"name\": \"GPGSA sample\", \"text\": \"$GPGSA,A,3,04,05,,09,12,,,24,,,,,2.5,1.3,2.1*39\", \"hex\": false}]",
    "connection_presets": "[{\"id\": \"example-nmea-gps-serial\", \"name\": \"NMEA GPS 9600\", \"note\": \"Typical GPS NMEA 0183 UART\", \"last_used\": 0.0, \"net_proto\": \"Serial\", \"ser_port\": \"\", \"ser_baud\": \"9600\", \"ser_databits\": \"8\", \"ser_parity\": \"None\", \"ser_stopbits\": \"1\", \"ser_flow\": \"None\", \"serial_dtr\": true, \"serial_rts\": true, \"net_local_ip\": \"0.0.0.0\", \"net_local_port\": \"8080\", \"net_remote_ip\": \"\", \"net_remote_port\": \"\", \"net_use_remote\": false, \"net_group_addr\": \"239.0.0.1\", \"vconn_loopback\": false, \"auto_reconnect\": true}]"
  },
