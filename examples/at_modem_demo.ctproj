{
  "format": "commtool-project",
  "format_version": 2,
  "app_version": "1.7.2",
  "name": "AT Modem Demo",
  "metadata": {
    "device_type": "at",
    "protocol_template": "at",
    "connection_type": "Serial",
    "description": "Line-split ASCII AT commands with sample snippets/sequence."
  },
  "settings": {
    "hexdump_view": false,
    "numview": false,
    "ansi_color": false,
    "proto_highlight": false,
    "packet_split": false,
    "packet_timeout": "20",
