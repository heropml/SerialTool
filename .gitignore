# Python 字节码缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# PyInstaller 打包产物 — 不入库（体积大、每次打包都变）；安装包改由 GitHub Release 分发
build/
build_onefile/
build_macos/
dist/
dist_onefile/
dist_verify*/
build_verify*/
installer/
# .spec 文件每次 PyInstaller 自动重新生成（build.bat 用 CLI 参数构造）
*.spec

# 运行时用户配置（每台机器不同）
settings.ini
settings-*.ini
*.ini.lock
*.mwlock

# Gitee 发版长期令牌（release_gitee.py 读它）—— 绝不入库
scripts/.gitee_token
.gitee_token

# pycdc Python 反编译器（恢复 main.py 时临时用过，SerialTool 编译/运行不需要）
tools/

# 临时/恢复残留
_strings.txt
recovered_pycdc.py

# venv
.venv/
.venv-linux/
.venv-macos/

# 编辑器 / IDE
.vscode/
.idea/
.claude/settings.local.json
*.swp
*.swo

# OS
Thumbs.db
.DS_Store
desktop.ini
build_local.log

# 本地规划草稿，不入库
docs/TODO.md

# 调研文档，不入库
需求说明.txt
需求说明.bak-*.txt
latest.json.keep

# 代理/审查工具的本地残留（计划文件、临时审查报告）
.zcode/
.codegraph/
/test.txt
scripts/_release_commit_body.txt
pytest-results.xml

# local pytest capture
dist_pytest_out.txt

